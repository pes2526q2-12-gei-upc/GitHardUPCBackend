{
  "openapi": "3.0.1",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "servers": [
    {
      "url": "http://localhost:8081",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Enrutamiento",
      "description": "API para la planificación y cálculo de rutas seguras en Barcelona"
    }
  ],
  "paths": {
    "/api/v1/calculate-route": {
      "post": {
        "tags": [
          "Enrutamiento"
        ],
        "summary": "Calcular la mejor ruta",
        "description": "Recibe coordenadas de origen y destino, valida que estén en Barcelona y devuelve los detalles de la ruta óptima (nodos, tiempo, distancia).",
        "operationId": "calculateRoute",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouteRequestDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Ruta calculada exitosamente",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RouteResponseDTO"
                }
              }
            }
          },
          "400": {
            "description": "Petición malformada o coordenadas fuera de los límites (Bad Request)"
          },
          "500": {
            "description": "Error interno en el cálculo del grafo espacial"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Coord": {
        "required": [
          "lat",
          "lon"
        ],
        "type": "object",
        "properties": {
          "lon": {
            "maximum": 2.23,
            "exclusiveMaximum": false,
            "minimum": 2.05,
            "exclusiveMinimum": false,
            "type": "number",
            "description": "Longitud de la coordenada geolocalizada",
            "format": "double",
            "example": 2.1686
          },
          "lat": {
            "maximum": 41.47,
            "exclusiveMaximum": false,
            "minimum": 41.32,
            "exclusiveMinimum": false,
            "type": "number",
            "description": "Latitud de la coordenada geolocalizada",
            "format": "double",
            "example": 41.3874
          }
        },
        "description": "Objeto que representa una coordenada geográfica (Latitud y Longitud) dentro del Área Metropolitana de Barcelona."
      },
      "RouteRequestDTO": {
        "required": [
          "destination",
          "origin"
        ],
        "type": "object",
        "properties": {
          "origin": {
            "$ref": "#/components/schemas/Coord"
          },
          "destination": {
            "$ref": "#/components/schemas/Coord"
          },
          "nroutes": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "DTO que encapsula los datos de la petición para calcular la ruta. Requiere las coordenadas exactas de origen y destino."
      },
      "PoiDTO": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Tipus de POI (ex: COMISSARIA, FONT, BANC)",
            "example": "COMISSARIA"
          },
          "name": {
            "type": "string",
            "description": "Nom descriptiu de l'element",
            "example": "Comissaria Eixample"
          },
          "lat": {
            "type": "number",
            "description": "Latitud del POI",
            "format": "double",
            "example": 41.3874
          },
          "lon": {
            "type": "number",
            "description": "Longitud del POI",
            "format": "double",
            "example": 2.1686
          }
        },
        "description": "Objecte que representa un Punt d'Interès (POI) al llarg de la ruta."
      },
      "Route": {
        "type": "object",
        "properties": {
          "coordinates": {
            "type": "array",
            "description": "Llista de coordenades [Longitud, Latitud] que formen la ruta.",
            "example": [
              [2.1685, 41.3873],
              [2.1744, 41.4036]
            ],
            "items": {
              "type": "array",
              "description": "Llista de coordenades [Longitud, Latitud] que formen la ruta.",
              "example": [
                [2.1685, 41.3873],
                [2.1744, 41.4036]
              ],
              "items": {
                "type": "number",
                "description": "Llista de coordenades [Longitud, Latitud] que formen la ruta.",
                "format": "double"
              }
            }
          },
          "distanceMeters": {
            "type": "number",
            "description": "Distància total de la ruta en metres.",
            "format": "double",
            "example": 1500.5
          },
          "estimatedTimeMinutes": {
            "type": "integer",
            "description": "Temps estimat a peu en minuts.",
            "format": "int32",
            "example": 18
          },
          "pois": {
            "type": "array",
            "description": "Llista de Punts d'Interès (POIs) propers a aquesta ruta.",
            "items": {
              "$ref": "#/components/schemas/PoiDTO"
            }
          }
        }
      },
      "RouteResponseDTO": {
        "type": "object",
        "properties": {
          "routes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Route"
            }
          }
        },
        "description": "DTO que encapsula la respuesta del cálculo de la ruta. Incluye la geometría (coordenadas), la distancia total y el tiempo estimado."
      }
    }
  }
}
